#!/usr/bin/env bash
set -u

repair=false
if [[ ${1:-} == --repair ]]; then
  repair=true
  shift
fi

policy_home=${SERVER_POLICY_HOME:-/home/claude}
projects_root=${1:-$policy_home/Projects}
expected_hooks=$policy_home/.config/git/hooks
common=$policy_home/.local/lib/server-development-consensus/dev-git-common.sh
policy_dir=$policy_home/.config/server-development-consensus
policy_file=$policy_dir/SERVER-DEVELOPMENT-CONSENSUS.md
port_registry=$policy_dir/DEVELOPMENT-PORT-REGISTRY.md
codex_policy_file=$policy_dir/CODEX-DEVELOPER-INSTRUCTIONS.md
managed_hooks_manifest=$policy_dir/managed-hooks.sha256
codex_updater=$policy_home/.local/bin/update-codex-config
worktree_tool=$policy_home/.local/bin/dev-worktree
changelog_tool=$policy_home/.local/bin/dev-changelog
failures=0
repaired=0
stale_branches=0
scan_file=
sorted_scan_file=
trap 'rm -f "${scan_file:-}" "${sorted_scan_file:-}"' EXIT

if [[ ${HOME:-} != "$policy_home" ]]; then
  printf 'FAIL policy home does not match HOME: policy=%s home=%s\n' \
    "$policy_home" "${HOME:-unset}"
  exit 1
fi
if [[ -n ${GIT_CONFIG_GLOBAL:-} || -n ${GIT_CONFIG_SYSTEM:-} ||
      -n ${GIT_CONFIG_COUNT:-} ]]; then
  printf 'FAIL redirected Git configuration is not allowed during policy audit\n'
  exit 1
fi
if [[ -n ${XDG_CONFIG_HOME:-} && $XDG_CONFIG_HOME != "$policy_home/.config" ]]; then
  printf 'FAIL XDG_CONFIG_HOME is outside the policy account\n'
  exit 1
fi
if [[ $(id -u) -eq 0 ]]; then
  printf 'FAIL policy audit must run as the non-root development account\n'
  exit 1
fi
if [[ ! -d $policy_home ]] ||
   [[ $(stat -c '%u' "$policy_home" 2>/dev/null) != "$(id -u)" ]]; then
  printf 'FAIL policy audit must run as the owner of %s\n' "$policy_home"
  exit 1
fi

if $repair && [[ ${SERVER_POLICY_CONFIG_LOCK_HELD:-0} != 1 ]]; then
  state_dir=$policy_home/.local/state/server-development-consensus
  if ! install -d -m 700 "$state_dir"; then
    printf 'FAIL cannot create policy state directory: %s\n' "$state_dir"
    exit 1
  fi
  if ! exec 9>"$state_dir/config.lock"; then
    printf 'FAIL cannot open policy configuration lock\n'
    exit 1
  fi
  if ! flock -x 9; then
    printf 'FAIL cannot acquire policy configuration lock\n'
    exit 1
  fi
fi

restore_config() {
  local scope=$1
  local repo=$2
  local key=$3
  local had_value=$4
  local old_value=$5
  local -a cmd=(git)
  if [[ $scope == global ]]; then
    cmd+=(config --global)
  else
    cmd+=(-C "$repo" config --local)
  fi
  if [[ $had_value == true ]]; then
    "${cmd[@]}" "$key" "$old_value" >/dev/null 2>&1
  else
    "${cmd[@]}" --unset-all "$key" >/dev/null 2>&1 || true
  fi
}

# Report task branches that were left behind after integration.
#
# `dev-worktree audit` only walks registered worktrees (`git worktree list`), so a
# branch created directly in the canonical checkout is invisible to it -- and
# `dev-worktree retire` never deletes a remote branch.  Without this scan the
# local half of "delete the agent-owned task branch after merge" is never
# enforced, and squash merges hide the loss from `git branch --merged`.
#
# Detection is content-based, mirroring branch_has_integrated_commits in
# dev-worktree: `git cherry` reports every commit as `-` when the branch's
# patches are all present in the default branch.  Silently discarding work is
# the failure mode this audit exists to prevent, so an excursion beyond the
# integration guardrails is reported as a finding, never repaired.
audit_stale_branches() {
  local repo=$1 default_branch=$2
  local default_ref branch tracking checks worktree_list integrated=0 gone_count=0
  default_ref=$(git -C "$repo" for-each-ref --format='%(refname:short)' \
    "refs/remotes/origin/$default_branch" 2>/dev/null)
  [[ -n $default_ref ]] || return 0
  worktree_list=$(git -C "$repo" worktree list --porcelain 2>/dev/null |
    awk '/^branch /{sub("refs/heads/", "", $2); print $2}')
  while IFS= read -r branch; do
    [[ -n $branch && $branch != "$default_branch" ]] || continue
    if [[ -n $worktree_list ]] && grep -qxF "$branch" <<<"$worktree_list"; then
      continue
    fi
    tracking=$(git -C "$repo" for-each-ref --format='%(upstream:track)' \
      "refs/heads/$branch" 2>/dev/null)
    if [[ $tracking == *'[gone]'* ]]; then
      printf 'WARN repo=%s branch=%s state=upstream_gone\n' "$repo" "$branch"
      gone_count=$((gone_count + 1))
      continue
    fi
    checks=$(git -C "$repo" cherry "$default_ref" "$branch" 2>/dev/null) || continue
    if [[ -n $checks ]] && ! grep -q '^+' <<<"$checks"; then
      printf 'WARN repo=%s branch=%s state=integrated_not_retired\n' \
        "$repo" "$branch"
      integrated=$((integrated + 1))
    fi
  done < <(git -C "$repo" for-each-ref --format='%(refname:short)' \
    refs/heads 2>/dev/null)
  stale_branches=$((stale_branches + integrated + gone_count))
}

resolve_repo_hooks_path() {
  local repo=$1
  local hooks_path=$2
  (
    cd "$repo" || exit 1
    resolve_hooks_path "$hooks_path"
  )
}

hooks_paths_are_same() {
  local repo=$1
  local left=$2
  local right=$3
  local resolved_left resolved_right
  resolved_left=$(resolve_repo_hooks_path "$repo" "$left") || return 2
  resolved_right=$(resolve_repo_hooks_path "$repo" "$right") || return 2
  [[ $resolved_left == "$resolved_right" ]]
}

hooks_path_is_forwardable() {
  local repo=$1
  local hooks_path=$2
  local resolved hook
  resolved=$(resolve_repo_hooks_path "$repo" "$hooks_path") || return 1
  [[ -d $resolved && -r $resolved && -x $resolved ]] || return 1
  if hooks_paths_are_same "$repo" "$resolved" "$expected_hooks"; then
    return 1
  fi
  while IFS= read -r hook; do
    if [[ -x $resolved/$hook ]]; then
      [[ -x $expected_hooks/$hook ]] || return 1
      if paths_identify_same_file "$resolved/$hook" "$expected_hooks/$hook"; then
        return 1
      else
        same_status=$?
        [[ $same_status -eq 1 ]] || return 1
      fi
    fi
  done < <(git_hook_names)
}

audit_global_chained_hooks() {
  local global_chain global_chain_status
  global_chain=$(git config --global --path --get serverPolicy.globalChainedHooksPath 2>/dev/null)
  global_chain_status=$?
  if [[ $global_chain_status -eq 1 ]]; then
    return 0
  fi
  if [[ $global_chain_status -gt 1 || -z $global_chain || $global_chain != /* ]]; then
    printf 'FAIL global chained hooks metadata is invalid\n'
    return 1
  fi
  if ! hooks_path_is_forwardable "$projects_root" "$global_chain"; then
    printf 'FAIL global chained hooks are not safely forwardable from %s\n' "$global_chain"
    return 1
  fi
}

if [[ ! -r $common ]]; then
  printf 'FAIL common policy library is unavailable: %s\n' "$common"
  exit 1
fi
# shellcheck disable=SC1090
source "$common"
if [[ ! -x $worktree_tool ]]; then
  printf 'FAIL worktree lifecycle tool is unavailable: %s\n' "$worktree_tool"
  failures=$((failures + 1))
fi
# The changelog check is advisory, so a missing tool degrades the check rather
# than failing the audit: a host that never publishes anything has no reason to
# have the generator installed. The check itself reports the gap per repository.
if [[ ! -x $changelog_tool ]]; then
  printf 'WARN changelog generator is unavailable; changelog drift is not checked: %s\n' \
    "$changelog_tool"
fi
if [[ ! -d $projects_root || ! -r $projects_root ]]; then
  printf 'FAIL cannot scan projects root %s\n' "$projects_root"
  exit 1
fi

if [[ ! -r $policy_file ]] ||
   ! grep -q '^## Internal Knowledge And Public Projection Boundary$' "$policy_file"; then
  printf 'FAIL canonical server policy is missing the internal/public knowledge boundary\n'
  failures=$((failures + 1))
else
  for policy_copy in \
    "$projects_root/AGENTS.md" \
    "$projects_root/CLAUDE.md" \
    "$projects_root/SERVER-DEVELOPMENT-CONSENSUS.md"; do
    if ! cmp -s "$policy_file" "$policy_copy"; then
      printf 'FAIL policy copy drifted from canonical source: %s\n' "$policy_copy"
      failures=$((failures + 1))
    fi
  done
fi
if [[ ! -r $port_registry ]] ||
   ! grep -q '^## Static Pool$' "$port_registry" ||
   ! cmp -s "$port_registry" "$projects_root/DEVELOPMENT-PORT-REGISTRY.md"; then
  printf 'FAIL development port registry is missing or drifted\n'
  failures=$((failures + 1))
fi
if [[ ! -x $codex_updater || ! -r $codex_policy_file ]] ||
   ! python3 "$codex_updater" --verify "$policy_home/.codex/config.toml" \
     "$codex_policy_file" >/dev/null 2>&1; then
  printf 'FAIL Codex developer instructions drifted from server policy\n'
  failures=$((failures + 1))
fi

expected_hooks_complete=true
if [[ ! -r $managed_hooks_manifest ]] ||
   ! (cd "$expected_hooks" && sha256sum --check --status "$managed_hooks_manifest"); then
  printf 'FAIL managed hook content failed integrity verification\n'
  failures=$((failures + 1))
  expected_hooks_complete=false
fi
while IFS= read -r hook; do
  case $hook in
    pre-commit|pre-merge-commit|pre-push|commit-msg)
      if [[ ! -f $expected_hooks/$hook || -L $expected_hooks/$hook ||
            ! -x $expected_hooks/$hook ]]; then
        printf 'FAIL managed policy hook is invalid: %s/%s\n' "$expected_hooks" "$hook"
        failures=$((failures + 1))
        expected_hooks_complete=false
      fi
      ;;
    *)
      if [[ ! -L $expected_hooks/$hook ]] ||
         [[ $(readlink "$expected_hooks/$hook" 2>/dev/null) != hook-forwarder ]]; then
        printf 'FAIL managed hook forwarder link is invalid: %s/%s\n' \
          "$expected_hooks" "$hook"
        failures=$((failures + 1))
        expected_hooks_complete=false
      fi
      ;;
  esac
done < <(git_hook_names)

global_hooks=$(git config --global --path --get core.hooksPath 2>/dev/null)
global_hooks_status=$?
if [[ $global_hooks_status -gt 1 ]]; then
  printf 'FAIL cannot inspect global core.hooksPath\n'
  failures=$((failures + 1))
elif [[ $global_hooks_status -eq 0 ]] &&
     hooks_paths_are_same "$projects_root" "$global_hooks" "$expected_hooks"; then
  if audit_global_chained_hooks; then
    printf 'ok global-hooks %s\n' "$expected_hooks"
  else
    failures=$((failures + 1))
  fi
elif $repair && $expected_hooks_complete; then
  old_global_chain=$(git config --global --path --get serverPolicy.globalChainedHooksPath 2>/dev/null)
  old_global_chain_status=$?
  if [[ $old_global_chain_status -gt 1 ]]; then
    printf 'FAIL cannot inspect global chained hooks metadata\n'
    failures=$((failures + 1))
  else
    old_global_chain_present=false
    [[ $old_global_chain_status -eq 0 ]] && old_global_chain_present=true
    chain_write_ok=true
    if [[ $global_hooks_status -eq 0 && -n $global_hooks ]]; then
      if [[ $global_hooks != /* ]] ||
         ! hooks_path_is_forwardable "$projects_root" "$global_hooks"; then
        chain_write_ok=false
      else
        canonical_global_hooks=$(resolve_repo_hooks_path "$projects_root" "$global_hooks") ||
          chain_write_ok=false
        if $chain_write_ok; then
          git config --global serverPolicy.globalChainedHooksPath "$canonical_global_hooks" ||
            chain_write_ok=false
        fi
      fi
    elif $old_global_chain_present; then
      git config --global --unset-all serverPolicy.globalChainedHooksPath ||
        chain_write_ok=false
    fi
    if $chain_write_ok && git config --global core.hooksPath "$expected_hooks"; then
      printf 'repaired global-hooks %s\n' "$expected_hooks"
      repaired=$((repaired + 1))
    else
      restore_config global '' serverPolicy.globalChainedHooksPath \
        "$old_global_chain_present" "${old_global_chain:-}"
      printf 'FAIL could not repair global core.hooksPath\n'
      failures=$((failures + 1))
    fi
  fi
else
  printf 'FAIL global-hooks expected=%s actual=%s\n' \
    "$expected_hooks" "${global_hooks:-unset}"
  failures=$((failures + 1))
fi

scan_file=$(mktemp)
sorted_scan_file=$(mktemp)
while IFS= read -r skipped_path; do
  printf 'skip unreadable non-development path %s\n' "$skipped_path"
done < <(find "$projects_root" -type d ! -readable -prune -print 2>/dev/null)
if ! find_project_git_entries "$projects_root" >"$scan_file"; then
  printf 'FAIL cannot scan projects root %s\n' "$projects_root"
  exit 1
fi
if ! sort -zu "$scan_file" >"$sorted_scan_file"; then
  printf 'FAIL cannot sort repository inventory for %s\n' "$projects_root"
  exit 1
fi

while IFS= read -r top_worktree; do
  printf 'WARN top-level task worktree violates Workspace Layout: %s\n' \
    "$top_worktree"
done < <(find "$projects_root" -mindepth 1 -maxdepth 1 -type d ! -name '.*' \
  -exec test -f '{}/.git' \; -print 2>/dev/null)

declare -A audited_worktree_roots=()
while IFS= read -r -d '' git_path; do
  repo=${git_path%/.git}

  # A runner working directory and a deploy checkout under the `_runners/`
  # functional directory are deployment artifacts, not projects: the installer
  # never manages them, and a job's checkout is created and discarded by the
  # runner. Their lack of delivery metadata is therefore not drift, and the
  # managed-repository rules below neither inspect nor repair them. The path is
  # still reported, so that a checkout cannot hide here unnoticed.
  #
  # This runs before any repository state command: a job may reclaim its
  # checkout after the inventory was taken, and a deployment artifact that
  # disappeared mid-audit must not read as an inspection failure. The branch
  # and dirty fields are best-effort additions for a checkout that is still
  # present.
  if runner_checkout_path "$repo"; then
    branch=$(git -C "$repo" branch --show-current 2>/dev/null) || branch=
    printf 'skip runner working directory %s branch=%s\n' \
      "$repo" "${branch:-detached}"
    continue
  fi

  if ! branch=$(git -C "$repo" branch --show-current 2>/dev/null) ||
     ! status_output=$(git -C "$repo" status --porcelain 2>/dev/null); then
    printf 'FAIL %s cannot inspect repository state\n' "$repo"
    failures=$((failures + 1))
    continue
  fi
  dirty=$(printf '%s\n' "$status_output" | awk 'NF { count++ } END { print count + 0 }')

  # Repository class. Externally governed repositories keep only the rules that
  # describe this host, so the delivery metadata below is neither inspected nor
  # repaired for them. An unreadable or invalid class is a finding, never an
  # implicit exemption.
  repo_class=$(git -C "$repo" config --local --get serverPolicy.repositoryClass 2>/dev/null) || {
    repo_class_status=$?
    if [[ $repo_class_status -eq 1 ]]; then
      repo_class=managed
    else
      printf 'FAIL %s cannot inspect repository class\n' "$repo"
      failures=$((failures + 1))
      continue
    fi
  }
  if [[ $repo_class != managed && $repo_class != external ]]; then
    printf 'FAIL %s repository class is invalid: %s\n' "$repo" "$repo_class"
    failures=$((failures + 1))
    continue
  fi

  # A publishing repository opts in to maintaining CHANGELOG.md by declaring
  # serverPolicy.publishesVersions; absence is the documented default, not a gap.
  # The declaration is read only for managed repositories: an externally
  # governed repository keeps its own release process, and a fork's upstream
  # version is not this host's to document.
  #
  # The check is a WARN rather than a FAIL because a changelog is updated on a
  # release cadence, not a commit cadence, and because --repair cannot fix it:
  # generating a changelog is a content decision, not drift repair. A WARN keeps
  # it a finding without gating the installer, which fails when the audit does.
  #
  # The obligation belongs to the repository, so it is checked once, at the one
  # checkout whose work tree is the repository's own. `serverPolicy.*` is
  # repository configuration and therefore shared by every linked worktree — a
  # declaration made for the repository is visible from a worktree doing
  # unrelated work. Reading it there would find that worktree's work tree, which
  # legitimately has no CHANGELOG.md, and report a finding against unrelated
  # work. The main checkout is the one whose git directory is the common
  # directory; a linked worktree's git directory is a per-worktree entry below
  # it. Only the main checkout's work tree can be compared with the rendered
  # changelog, because the generating tool reads the repository it is given and
  # writes beside it.
  git_dir=$(git -C "$repo" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)
  common_dir_for_changelog=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  is_main_checkout=false
  if [[ -n $git_dir && -n $common_dir_for_changelog && $git_dir = "$common_dir_for_changelog" ]]; then
    is_main_checkout=true
  fi
  if [[ $repo_class == managed && $is_main_checkout == true ]]; then
    # `git config --get` exits 0 with empty output for a key set to the empty
    # string, so "present but empty" and "absent" are different states and only
    # the absent one is the default. Treating them alike would let an empty
    # value read as undeclared — an implicit exemption from a malformed
    # declaration, which is the failure mode this whole block avoids.
    publishes_versions=
    publishes_declared=false
    if publishes_versions=$(git -C "$repo" config --local --get serverPolicy.publishesVersions 2>/dev/null); then
      publishes_declared=true
    else
      publishes_status=$?
      if [[ $publishes_status -ne 1 ]]; then
        printf 'FAIL %s cannot inspect serverPolicy.publishesVersions\n' "$repo"
        failures=$((failures + 1))
        continue
      fi
      publishes_versions=
    fi
    case $publishes_versions in
      true)
        if [[ ! -f $repo/CHANGELOG.md ]]; then
          printf 'WARN %s declares serverPolicy.publishesVersions but has no CHANGELOG.md\n' \
            "$repo"
        elif [[ -x $changelog_tool ]]; then
          changelog_output=$("$changelog_tool" --check "$repo" 2>&1)
          changelog_status=$?
          case $changelog_status in
            0) ;;
            1)
              printf 'WARN %s changelog drifted from its commits: %s\n' \
                "$repo" "$changelog_output"
              ;;
            *)
              # The tool separates "the file drifted" (1) from "the check could
              # not run" (2). Collapsing them would report a missing git-cliff
              # or an unreadable declaration as a content finding, which is a
              # false claim about the file.
              printf 'WARN %s changelog could not be checked: %s\n' \
                "$repo" "$changelog_output"
              ;;
          esac
        fi
        ;;
      '')
        if $publishes_declared; then
          printf 'FAIL %s serverPolicy.publishesVersions must be true or false, got an empty value\n' \
            "$repo"
          failures=$((failures + 1))
        fi
        ;;
      *)
        printf 'FAIL %s serverPolicy.publishesVersions must be true or false, got: %s\n' \
          "$repo" "$publishes_versions"
        failures=$((failures + 1))
        ;;
    esac
  fi

  local_hooks=$(git -C "$repo" config --local --path --get core.hooksPath 2>/dev/null)
  local_hooks_status=$?
  chained_hooks=$(git -C "$repo" config --local --path --get serverPolicy.chainedHooksPath 2>/dev/null)
  chained_hooks_status=$?
  if [[ $local_hooks_status -gt 1 || $chained_hooks_status -gt 1 ]]; then
    printf 'FAIL %s cannot inspect hook configuration\n' "$repo"
    failures=$((failures + 1))
    continue
  fi
  [[ $local_hooks_status -eq 0 ]] || local_hooks=
  [[ $chained_hooks_status -eq 0 ]] || chained_hooks=

  local_hooks_are_managed=false
  if [[ -n $local_hooks ]] && hooks_paths_are_same "$repo" "$local_hooks" "$expected_hooks"; then
    local_hooks_are_managed=true
  fi
  if [[ $repo_class == managed ]] && [[ -n $local_hooks ]] && ! $local_hooks_are_managed; then
    if $repair && $expected_hooks_complete; then
      if ! hooks_path_is_forwardable "$repo" "$local_hooks"; then
        printf 'FAIL %s cannot safely forward hooks from %s\n' "$repo" "$local_hooks"
        failures=$((failures + 1))
      else
        canonical_local_hooks=$(resolve_repo_hooks_path "$repo" "$local_hooks")
        old_chain_present=false
        [[ $chained_hooks_status -eq 0 ]] && old_chain_present=true
        if git -C "$repo" config --local serverPolicy.chainedHooksPath "$canonical_local_hooks" &&
           git -C "$repo" config --local core.hooksPath "$expected_hooks"; then
          chained_hooks=$canonical_local_hooks
          local_hooks=$expected_hooks
          repaired=$((repaired + 1))
        else
          restore_config local "$repo" serverPolicy.chainedHooksPath \
            "$old_chain_present" "${chained_hooks:-}"
          printf 'FAIL %s could not repair core.hooksPath\n' "$repo"
          failures=$((failures + 1))
        fi
      fi
    else
      printf 'FAIL %s overrides core.hooksPath=%s\n' "$repo" "$local_hooks"
      failures=$((failures + 1))
    fi
  fi

  default_branch=$(
    cd "$repo" &&
      SERVER_POLICY_IGNORE_CONFIG=1 &&
      export SERVER_POLICY_IGNORE_CONFIG &&
      # shellcheck disable=SC1090
      source "$common" &&
      default_branch_for_remote origin
  ) 2>/dev/null
  default_status=$?
  origin_url=$(git -C "$repo" remote get-url origin 2>/dev/null)
  origin_status=$?
  configured_default=$(git -C "$repo" config --local --get serverPolicy.defaultBranch 2>/dev/null)
  configured_status=$?
  if [[ $configured_status -gt 1 ]]; then
    printf 'FAIL %s cannot inspect default-branch metadata\n' "$repo"
    failures=$((failures + 1))
    configured_default=
  elif [[ $configured_status -ne 0 ]]; then
    configured_default=
  fi
  if [[ $repo_class == managed ]] && [[ $origin_status -eq 0 && $default_status -ne 0 ]]; then
    if $repair && [[ $configured_status -eq 0 ]]; then
      if git -C "$repo" config --local --unset-all serverPolicy.defaultBranch; then
        configured_default=
        repaired=$((repaired + 1))
      else
        printf 'FAIL %s could not clear stale default-branch metadata\n' "$repo"
        failures=$((failures + 1))
      fi
    fi
    printf 'FAIL %s cannot determine origin default branch\n' "$repo"
    failures=$((failures + 1))
  elif [[ $origin_status -gt 2 ]]; then
    printf 'FAIL %s cannot inspect origin remote\n' "$repo"
    failures=$((failures + 1))
  fi
  if [[ $repo_class == managed ]] && [[ $default_status -eq 0 && $configured_default != "$default_branch" ]]; then
    if $repair; then
      if git -C "$repo" config --local serverPolicy.defaultBranch "$default_branch"; then
        configured_default=$default_branch
        repaired=$((repaired + 1))
      else
        printf 'FAIL %s could not repair default-branch metadata\n' "$repo"
        failures=$((failures + 1))
      fi
    else
      printf 'FAIL %s default-branch expected=%s actual=%s\n' \
        "$repo" "$default_branch" "${configured_default:-unset}"
      failures=$((failures + 1))
    fi
  fi

  if [[ $repo_class == managed && $default_status -eq 0 ]]; then
    audit_stale_branches "$repo" "$default_branch"
  fi

  common_dir=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [[ -n $common_dir && -z ${audited_worktree_roots[$common_dir]+present} ]]; then
    audited_worktree_roots[$common_dir]=true
    if [[ $default_status -eq 0 && -x $worktree_tool ]]; then
      worktree_output=$(
        "$worktree_tool" audit --repo "$repo" --default "$default_branch" 2>&1
      )
      worktree_status=$?
      if [[ $worktree_status -eq 0 ]]; then
        printf 'ok worktrees %s\n' "$repo"
      else
        printf 'FAIL worktree lifecycle %s\n%s\n' "$repo" "$worktree_output"
        failures=$((failures + 1))
      fi
    fi
  fi

  chain_state=none
  if [[ -n $chained_hooks ]]; then
    chain_path=$(resolve_repo_hooks_path "$repo" "$chained_hooks" 2>/dev/null || true)
    if [[ -n $chain_path ]] && hooks_path_is_forwardable "$repo" "$chained_hooks"; then
      chain_state=$chained_hooks
    else
      printf 'FAIL %s chained hooks are not safely forwardable from %s\n' \
        "$repo" "${chain_path:-$chained_hooks}"
      failures=$((failures + 1))
    fi
  fi

  printf 'repo %s branch=%s default=%s dirty=%s chain=%s class=%s\n' \
    "$repo" "${branch:-detached}" "${configured_default:-unknown}" "$dirty" \
    "$chain_state" "$repo_class"
done <"$sorted_scan_file"

printf 'audit complete: failures=%d repaired=%d stale_branches=%d\n' \
  "$failures" "$repaired" "$stale_branches"
[[ $failures -eq 0 ]]
