#!/usr/bin/env bash
# dev-service-inventory — 列出在本机（development host）上运行的服务，
# 并标出哪些违反了「开发机不承载对外服务」这条共识。
#
# 为什么需要它：共识里已经写明开发机不承载可从公网访问的服务、新服务应直接
# 部署到 service host。但条文不会自己生效 —— 一台服务悄悄起在开发机上、
# 绑了 0.0.0.0，要等某次迁移或审计才被发现。这个工具把"该不该在这台机器上"
# 变成一条每次都能重跑的命令。
#
# 两种用法（同一份判据，不同出口）：
#   dev-service-inventory            人类可读清单（默认）
#   dev-service-inventory --check    违规即非零退出；可放进审计/钩子
#   dev-service-inventory --json     机器可读
#
# 判据（按共识 Host Fleet 一节）：
#   - 绑定非环回地址、且不是平台入口（SSH/HTTP/HTTPS）⇒ 违规，应迁往 service host
#   - 绑定环回 ⇒ 不违规（本机自用/开发工具）
#   - 无法归因（拿不到监听者）⇒ 报告为 unknown，不当作通过
#
# 退避说明：service host 上的服务本就不该出现在这份清单里；本工具只看本机进程。

set -u

mode=report
case "${1:-}" in
  --check) mode=check ;;
  --json) mode=json ;;
  -h|--help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  '') ;;
  *) printf 'usage: %s [--check|--json]\n' "$0" >&2; exit 64 ;;
esac

# 平台入口端口：共识明确允许开发机对外提供 SSH 与 HTTP(S)。
PLATFORM_PORTS=" 22 80 443 "

# 已评估并接受的服务落点例外。
#
# 为什么需要它：共识说"开发机承载对外服务是债务"，但有些债务**当前无法偿还**——
# 典型是已编译程序不提供绑定地址开关（如 blog-chat 的 `*:27641`、dinotty 的
# `0.0.0.0:8503`）。这类项既不能靠改配置修好，也不该让整个安装器/审计瘫痪。
#
# 但"接受"必须是**显式的、带理由的、可审计的**，不是把检查关掉：
#   - 每项都要写清 port + 程序名 + 为什么不能修 + 补偿控制；
#   - 审计会把它报成 ACCEPTED（可见），而不是 ok（沉默）；
#   - 未列出的任何非环回监听仍然是 violation。
#
# 键为 "<port>/<owner>"，这样程序改名或端口被别的服务占用都会重新变成违规。
declare -A ACCEPTED_RESIDUALS=(
  ["8503/dinotty-server"]="已编译二进制硬编码 0.0.0.0，无 --host/--bind、无 DINOTTY_* 环境变量；公网由 ufw 默认拒绝挡住（实测 closed），仅 tailnet 可达"
  ["27641/api"]="已编译 Go 二进制不提供绑定开关；由安全组/ufw 挡在公网之外"
)

command -v ss >/dev/null 2>&1 || { printf 'ss is required\n' >&2; exit 69; }

# 测试缝：允许用夹具替代真实监听表，避免测试依赖机器上正在跑什么。
# 生产路径永远走 ss；这两个变量只由测试设置。
SS_LISTEN_CMD=${DEV_SERVICE_INVENTORY_SS_LISTEN:-}
SS_LISTENP_CMD=${DEV_SERVICE_INVENTORY_SS_LISTENP:-}

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

# 采集：每个 LISTEN socket 一行，字段为 地址|端口
#
# ss 的输出在不同 util-linux 版本间有差异，因此只用最稳定的列：
# 第 4 列为 local address:port，`users:(("name",pid=N,...))` 在需要时解析。
if [[ -n $SS_LISTEN_CMD ]]; then
  eval "$SS_LISTEN_CMD" 2>/dev/null
else
  ss -tlnH 2>/dev/null
fi | while read -r _ _ _ local _; do
  [[ -n $local ]] || continue
  port=${local##*:}
  [[ $port =~ ^[0-9]+$ ]] || continue
  printf '%s|%s\n' "$local" "$port"
done >"$tmp_dir/listen"

# 归因：完全不依赖 root。
#
# 曾用 `sudo -n ss -tlnp`，但审计 unit 带 NoNewPrivileges=true —— 那里 sudo
# 必然失败，于是每个监听都退化成 unknown：网络平面（tailscaled）被误判成违规，
# 已评估例外（dinotty）也永远匹配不上。归因必须能在无特权下完成。
#
# 无特权也能拿到归属，来自 ss -e 的扩展字段：
#   - 自己用户的 socket：`users:(("name",pid=N))` 直接给名字
#   - 别人的 socket（如 root 的 tailscaled）：不给名字，但给
#     `cgroup:/system.slice/tailscaled.service`，可反查 unit 的主进程名
# 两条路都拿不到时才标 unknown —— 未知不等于安全。
# 注意 ss -e 的 cgroup 字段需要 AF_NETLINK；审计 unit 的
# RestrictAddressFamilies 因此必须带上 AF_NETLINK，否则这里只剩 sk:0。
if [[ -n $SS_LISTENP_CMD ]]; then
  eval "$SS_LISTENP_CMD" 2>/dev/null | tee "$tmp_dir/listenp" >/dev/null
  attributed=yes
elif ss -tlnpe 2>/dev/null | tee "$tmp_dir/listenp" >/dev/null; then
  attributed=yes
else
  : >"$tmp_dir/listenp"
  attributed=no
fi

# 从一个 ss 行里解出监听者名字。
#
# 顺序即优先级：users:() 的名字最准（它就是进程名）；拿不到（别人的 socket）
# 就退回 cgroup 对应的 unit —— 先问 systemd 要主进程名，再退回 unit 名本身
# （unit 名去掉 .service/.scope 后缀，通常与程序同名）。
# 反查全程非特权：systemctl show 可读、/proc/<pid>/comm 世界可读。
owner_of_listener() {
  local line=$1 name unit pid
  name=$(printf '%s\n' "$line" | grep -oP 'users:\(\("\K[^"]+' | head -1)
  if [[ -n $name ]]; then
    printf '%s\n' "$name"
    return 0
  fi
  unit=$(printf '%s\n' "$line" | grep -oE 'cgroup:[^ ]+' | head -1)
  unit=${unit#cgroup:}
  unit=${unit##*/}
  # socket-activated 服务（如 ssh.socket）没有主进程名可查，但它本身就能说明归属，
  # 且 `<name>.socket` 对应的服务名就是去掉后缀的 `<name>`。不认这一支的话，
  # sshd 这类 socket 激活的平台入口会整条退化成 unknown。
  case $unit in
    *.socket)
      printf '%s\n' "${unit%.socket}"
      return 0
      ;;
    *.service|*.scope)
      pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
      [[ $pid =~ ^[0-9]+$ && $pid -ne 0 ]] ||
        pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)
      if [[ $pid =~ ^[0-9]+$ && $pid -ne 0 ]]; then
        name=$(ps -o comm= -p "$pid" 2>/dev/null | head -1)
        if [[ -n $name ]]; then
          printf '%s\n' "$name"
          return 0
        fi
      fi
      printf '%s\n' "${unit%.*}"
      return 0
      ;;
  esac
  return 1
}

violations=0
unknown=0
accepted=0
rows=0

emit_row() {
  rows=$((rows + 1))
}

# 判断一个监听地址是否"非环回"。
# 只比较地址部分（调用方已剥掉端口），因此这里不需要处理 ":::port" 之类形态。
is_non_loopback() {
  local addr=$1
  case $addr in
    127.*) return 1 ;;
    "::1"|"[::1]") return 1 ;;
    localhost*) return 1 ;;
  esac
  return 0
}

# 某些监听属于"网络平面本身"，不是业务服务：VPN/覆盖网络自己绑的接口地址。
# 把它们算成"应迁往 service host"是错的——把 tailscaled 搬走没有意义。
# 判据是进程名，不是地址（地址会随节点变化）。
# 私有覆盖网（Tailscale）的地址段。绑在这些地址上的监听只对编队内可达，
# 属于开发平面内部通信，不是"承载对外服务"。
#   IPv4: 100.64.0.0/10  (CGNAT，Tailscale 使用)
#   IPv6: fd7a:115c:a1e0::/48 (Tailscale ULA)
is_overlay_address() {
  local addr=$1
  # 去掉 ss 在地址后附加的 %interface
  addr=${addr%%%}
  [[ $addr == \[* ]] && addr=${addr#[} && addr=${addr%]}
  case $addr in
    100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
    fd7a:115c:a1e0::*) return 0 ;;
  esac
  return 1
}

is_network_plane() {
  local owner=$1
  case $owner in
    tailscaled|tailscale) return 0 ;;
    wireguard*|wg-quick*) return 0 ;;
  esac
  return 1
}

result_lines="$tmp_dir/result"
: >"$result_lines"

while IFS='|' read -r local port; do
  addr=${local%:*}
  [[ -n $addr ]] || addr=$local

  if ! is_non_loopback "$addr"; then
    continue   # 环回监听：不算违规
  fi

  # 先归因再判性质：网络平面（VPN/覆盖网络）不算业务服务。
  owner=unknown
  if [[ $attributed == yes ]]; then
    # 按第 4 列（local address:port）整列精确匹配。
    # 曾用 `grep -F ":$port "`，它会命中别的字段里的同名子串 ——
    # `sk:22 ` 让 0.0.0.0:2281 那条拿下 :22 的归属，于是 sshd 被报成 dockerd。
    line=$(awk -v want="$local" '$4 == want { print; exit }' "$tmp_dir/listenp" 2>/dev/null)
    # 解不出名字时保持 unknown：宁可报告"未知"，也不把它当成安全。
    owner=$(owner_of_listener "$line") || owner=unknown
    [[ -n $owner ]] || owner=unknown
  fi

  if is_network_plane "$owner"; then
    verdict=plane
  elif is_overlay_address "$addr"; then
    # 绑在私有覆盖网地址上，等于只对编队内的机器可达，没有对外暴露。
    # 这与"绑 0.0.0.0"不是一回事：判据是地址，不是程序名 ——
    # 所以同一个 frps 若改回 0.0.0.0 仍然会被判违规。
    verdict=plane
  elif [[ $PLATFORM_PORTS == *" $port "* ]]; then
    verdict=platform
  elif [[ -n ${ACCEPTED_RESIDUALS["$port/$owner"]+present} ]]; then
    # 已评估的例外：报告出来（可见），但不计入违规。
    verdict=accepted
    accepted=$((accepted + 1))
  else
    verdict=violation
    violations=$((violations + 1))
  fi

  [[ $owner == unknown ]] && unknown=$((unknown + 1))

  emit_row
  printf '%s\t%s\t%s\t%s\t\n' "$verdict" "$port" "$local" "$owner" >>"$result_lines"
done <"$tmp_dir/listen"

sorted="$tmp_dir/sorted"
sort -t$'\t' -k2 -n "$result_lines" >"$sorted"

if [[ $mode == json ]]; then
  printf '{"violations":%d,"unknown_owner":%d,"listeners":[' "$violations" "$unknown"
  first=1
  while IFS=$'\t' read -r verdict port local owner _; do
    [[ $first -eq 1 ]] || printf ','
    first=0
    printf '{"port":%s,"address":"%s","owner":"%s","verdict":"%s"}' \
      "$port" "$local" "$owner" "$verdict"
  done <"$sorted"
  printf ']}\n'
elif [[ $mode == check ]]; then
  # --check 供审计/钩子调用：只在有问题时出声，不打印整张表。
  if [[ $violations -gt 0 ]]; then
    while IFS=$'\t' read -r verdict port local owner _; do
      [[ $verdict == violation ]] || continue
      printf 'FAIL dev host serves %s on %s (owner=%s) — move it to a service host\n' \
        "$port" "$local" "$owner" >&2
    done <"$sorted"
  fi
  if [[ $unknown -gt 0 ]]; then
    printf 'note: %d listener(s) could not be attributed (no users:/cgroup field)\n' \
      "$unknown" >&2
  fi
else
  if [[ $rows -eq 0 ]]; then
    printf 'dev-service-inventory: 本机没有非环回监听（除平台入口）\n'
  else
    printf '%-10s %-6s %-24s %-16s %s\n' VERDICT PORT ADDRESS OWNER NOTE
    while IFS=$'\t' read -r verdict port local owner _; do
      note=-
      [[ $verdict == violation ]] && note='应迁往 service host'
      [[ $verdict == platform ]] && note='平台入口，允许'
      [[ $verdict == plane ]] && note='网络平面自身，跳过'
      [[ $verdict == accepted ]] && note='已评估例外，见工具内 ACCEPTED_RESIDUALS'
      printf '%-10s %-6s %-24s %-16s %s\n' "$verdict" "$port" "$local" "$owner" "$note"
    done <"$sorted"
  fi
  printf '\n本机非环回监听：%d（违规 %d，已接受例外 %d，属主未知 %d）\n' \
    "$rows" "$violations" "$accepted" "$unknown"
  if [[ $unknown -gt 0 ]]; then
    printf '注意：有 %d 项无法归因（需要 sudo ss -p）。未知不等于安全。\n' "$unknown"
  fi
fi

if [[ $mode == check ]]; then
  if [[ $violations -gt 0 ]]; then
    printf 'FAIL %d service(s) on the development host bind a non-loopback address\n' \
      "$violations" >&2
    exit 1
  fi
  exit 0
fi
