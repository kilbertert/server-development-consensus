#!/usr/bin/env python3
"""Update Codex developer_instructions while preserving unrelated TOML."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import ctypes
from dataclasses import dataclass
import errno
import fcntl
import os
from pathlib import Path
import secrets
import stat
import tempfile
from typing import Iterator

try:
    import tomlkit
except ModuleNotFoundError as exc:
    raise SystemExit(
        "update-codex-config requires the installer dependency tomlkit"
    ) from exc


def desired_value(instructions: str) -> str:
    return instructions.rstrip() + "\n"


def updated_toml(original: str, instructions: str) -> str:
    document = tomlkit.parse(original) if original.strip() else tomlkit.document()
    value = desired_value(instructions)
    if "developer_instructions" in document:
        document["developer_instructions"] = value
        result = tomlkit.dumps(document)
    else:
        prefix = tomlkit.document()
        prefix["developer_instructions"] = value
        result = tomlkit.dumps(prefix)
        if original:
            result += "\n" + original
    parsed = tomlkit.parse(result)
    if parsed.get("developer_instructions") != value:
        raise ValueError("updated developer_instructions did not round-trip")
    return result


@dataclass(frozen=True)
class ConfigSnapshot:
    exists: bool
    content: str
    identity: tuple[int, int, int, int, int] | None
    mode: int
    uid: int
    gid: int
    xattrs: tuple[tuple[str, bytes], ...]


def read_xattrs(descriptor: int) -> tuple[tuple[str, bytes], ...]:
    try:
        names = os.listxattr(descriptor)
        return tuple(sorted((name, os.getxattr(descriptor, name)) for name in names))
    except OSError as exc:
        if exc.errno in {errno.ENOTSUP, errno.EOPNOTSUPP}:
            return ()
        raise


def read_config_snapshot(config: Path) -> ConfigSnapshot:
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(config, flags)
    except FileNotFoundError:
        return ConfigSnapshot(
            False,
            "",
            None,
            0o600,
            os.geteuid(),
            os.getegid(),
            (),
        )
    except OSError as exc:
        if config.is_symlink():
            raise ValueError(f"refusing to read symlinked Codex config: {config}") from exc
        raise

    with os.fdopen(descriptor, "r", encoding="utf-8") as handle:
        before = os.fstat(handle.fileno())
        if not stat.S_ISREG(before.st_mode):
            raise ValueError(f"Codex config is not a regular file: {config}")
        content = handle.read()
        after = os.fstat(handle.fileno())
        xattrs = read_xattrs(handle.fileno())

    before_identity = (
        before.st_dev,
        before.st_ino,
        before.st_size,
        before.st_mtime_ns,
        before.st_ctime_ns,
    )
    after_identity = (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mtime_ns,
        after.st_ctime_ns,
    )
    if before_identity != after_identity:
        raise RuntimeError(f"Codex config changed while it was being read: {config}")
    return ConfigSnapshot(
        True,
        content,
        after_identity,
        stat.S_IMODE(after.st_mode) & 0o777,
        after.st_uid,
        after.st_gid,
        xattrs,
    )


@contextmanager
def config_update_lock(config: Path) -> Iterator[None]:
    lock_path = config.with_name(f"{config.name}.lock")
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(lock_path, flags, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def fsync_directory(directory: Path) -> None:
    descriptor = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def apply_metadata(descriptor: int, snapshot: ConfigSnapshot) -> None:
    os.fchmod(descriptor, snapshot.mode)
    if os.geteuid() == 0:
        os.fchown(descriptor, snapshot.uid, snapshot.gid)
    elif (snapshot.uid, snapshot.gid) != (os.geteuid(), os.getegid()):
        raise PermissionError("cannot preserve Codex config ownership")
    for name, value in snapshot.xattrs:
        os.setxattr(descriptor, name, value)
    os.fsync(descriptor)


def renameat2(source: Path, target: Path, flags: int) -> None:
    function = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if function is None:
        raise RuntimeError("atomic Codex config updates require Linux renameat2")
    result = function(
        ctypes.c_int(-100),
        ctypes.c_char_p(os.fsencode(source)),
        ctypes.c_int(-100),
        ctypes.c_char_p(os.fsencode(target)),
        ctypes.c_uint(flags),
    )
    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number), str(target))


def path_identity(path: Path) -> tuple[int, int, int, int, int]:
    path_stat = path.lstat()
    return (
        path_stat.st_dev,
        path_stat.st_ino,
        path_stat.st_size,
        path_stat.st_mtime_ns,
        path_stat.st_ctime_ns,
    )


def snapshots_match_inode_and_content(
    left: ConfigSnapshot | None, right: ConfigSnapshot | None
) -> bool:
    if left is None or right is None or left.exists != right.exists:
        return False
    if not left.exists:
        return True
    return (
        left.identity is not None
        and right.identity is not None
        and left.identity[:2] == right.identity[:2]
        and left.content == right.content
        and (left.mode, left.uid, left.gid, left.xattrs)
        == (right.mode, right.uid, right.gid, right.xattrs)
    )


def preserve_recovery_file(config: Path, temp_path: Path) -> Path:
    while True:
        recovery_path = config.with_name(
            f".{config.name}.recovery-{os.getpid()}-{secrets.token_hex(6)}"
        )
        try:
            renameat2(temp_path, recovery_path, 1)
        except OSError as exc:
            if exc.errno == errno.EEXIST:
                continue
            raise
        fsync_directory(config.parent)
        return recovery_path


def compare_and_replace(
    config: Path,
    temp_path: Path,
    original: ConfigSnapshot,
    replacement: ConfigSnapshot,
) -> None:
    if not original.exists:
        try:
            renameat2(temp_path, config, 1)
        except OSError as exc:
            if exc.errno == errno.EEXIST:
                raise RuntimeError(
                    f"Codex config appeared during update; retry without overwriting it: {config}"
                ) from exc
            raise
        fsync_directory(config.parent)
        return

    renameat2(temp_path, config, 2)
    old_path_identity = path_identity(temp_path)
    old_at_temp: ConfigSnapshot | None = None
    current_config: ConfigSnapshot | None = None
    read_error: Exception | None = None
    try:
        old_at_temp = read_config_snapshot(temp_path)
        current_config = read_config_snapshot(config)
    except Exception as exc:
        read_error = exc

    if (
        read_error is None
        and snapshots_match_inode_and_content(old_at_temp, original)
        and snapshots_match_inode_and_content(current_config, replacement)
    ):
        preserve_recovery_file(config, temp_path)
        return

    can_restore = False
    try:
        can_restore = (
            path_identity(temp_path) == old_path_identity
            and snapshots_match_inode_and_content(
                read_config_snapshot(config), replacement
            )
        )
    except Exception:
        can_restore = False
    if can_restore:
        renameat2(temp_path, config, 2)
        temp_path.unlink(missing_ok=True)
        fsync_directory(config.parent)
        recovery_path = None
    else:
        recovery_path = preserve_recovery_file(config, temp_path)
    recovery_note = (
        f"; recovery copy retained at {recovery_path}" if recovery_path else ""
    )
    raise RuntimeError(
        f"Codex config changed during atomic update; external content was preserved: {config}"
        f"{recovery_note}"
    ) from read_error


def replace_if_unchanged(config: Path, snapshot: ConfigSnapshot, result: str) -> None:
    temp_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", encoding="utf-8", dir=config.parent, delete=False
        ) as handle:
            handle.write(result)
            handle.flush()
            apply_metadata(handle.fileno(), snapshot)
            temp_path = Path(handle.name)
        replacement = read_config_snapshot(temp_path)
        compare_and_replace(config, temp_path, snapshot, replacement)
        temp_path = None
    finally:
        if temp_path is not None:
            temp_path.unlink(missing_ok=True)


def main() -> None:
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--verify", action="store_true")
    parser.add_argument("config", type=Path)
    parser.add_argument("instructions", type=Path)
    args = parser.parse_args()

    instructions = args.instructions.read_text(encoding="utf-8")
    if args.verify:
        snapshot = read_config_snapshot(args.config)
        if not snapshot.content.strip():
            raise ValueError("Codex config is missing")
        parsed = tomlkit.parse(snapshot.content)
        if parsed.get("developer_instructions") != desired_value(instructions):
            raise ValueError("Codex developer_instructions do not match policy")
        return

    if args.check:
        snapshot = read_config_snapshot(args.config)
        updated_toml(snapshot.content, instructions)
        return

    args.config.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with config_update_lock(args.config):
        snapshot = read_config_snapshot(args.config)
        result = updated_toml(snapshot.content, instructions)
        if result == snapshot.content:
            return
        replace_if_unchanged(args.config, snapshot, result)


if __name__ == "__main__":
    main()
