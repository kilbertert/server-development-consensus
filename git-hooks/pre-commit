#!/bin/sh
set -eu

hook_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
policy_home=${SERVER_POLICY_HOME:-$HOME}
case "$hook_dir" in
  */.config/git/hooks) policy_home=${hook_dir%/.config/git/hooks} ;;
esac
. "$policy_home/.local/lib/server-development-consensus/dev-git-common.sh"

# Externally governed repositories keep their own delivery process; the server
# contract applies only to server-managed repositories. An unreadable class
# stops the commit instead of silently exempting it.
repository_class_value=$(repository_class) || {
  printf '%s\n' 'SERVER POLICY: cannot determine the repository class; commit stopped safely.' >&2
  exit 1
}
if [ "$repository_class_value" = managed ]; then
  enforce_default_branch_commit_policy || exit 1
fi

if chained_hook=$(chained_hook_for pre-commit); then
  if paths_identify_same_file "$0" "$chained_hook"; then
    printf '%s\n' 'SERVER POLICY: chained pre-commit hook resolves to the managed hook; commit stopped safely.' >&2
    exit 1
  else
    same_status=$?
    [ "$same_status" -eq 1 ] || {
      printf '%s\n' 'SERVER POLICY: cannot validate the chained pre-commit hook; commit stopped safely.' >&2
      exit 1
    }
  fi
  exec "$chained_hook" "$@"
else
  chained_status=$?
  if [ "$chained_status" -ne 1 ]; then
    printf '%s\n' 'SERVER POLICY: cannot resolve the chained pre-commit hook; commit stopped safely.' >&2
    exit 1
  fi
fi

exit 0
