#!/bin/sh
set -eu

. "$HOME/.local/lib/server-development-consensus/dev-git-common.sh"

remote=${1:-origin}
push_url=${2:-}
input_file=$(mktemp)
trap 'rm -f "$input_file"' EXIT
cat >"$input_file"

if ! git remote get-url "$remote" >/dev/null 2>&1; then
  printf '%s\n' 'SERVER POLICY: pushes must target a configured remote so its default branch can be verified.' >&2
  exit 1
fi

[ -n "$push_url" ] || {
  printf '%s\n' 'SERVER POLICY: cannot determine the actual push target; push stopped safely.' >&2
  exit 1
}
default_branch=$(default_branch_for_url "$push_url") || {
  printf '%s\n' 'SERVER POLICY: cannot determine the push target default branch; push stopped safely.' >&2
  printf '%s\n' 'Verify the remote URL and its symbolic HEAD before retrying.' >&2
  exit 1
}

blocked=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${remote_ref:-}" ] || continue
  if [ "$remote_ref" = "refs/heads/$default_branch" ]; then
    blocked=1
  fi
done <"$input_file"

if [ "$blocked" -eq 1 ]; then
  printf '\n%s\n' 'SERVER POLICY: direct pushes to the default branch are prohibited.' >&2
  printf 'Remote: %s  Default branch: %s\n' "$remote" "$default_branch" >&2
  printf '%s\n' 'Create a task branch, push it, and merge through a PR after required CI and human review pass.' >&2
  printf '%s\n' 'Use: dev-start TYPE DESCRIPTION' >&2
  exit 1
fi

if chained_hook=$(chained_hook_for pre-push); then
  if paths_identify_same_file "$0" "$chained_hook"; then
    printf '%s\n' 'SERVER POLICY: chained pre-push hook resolves to the managed hook; push stopped safely.' >&2
    exit 1
  else
    same_status=$?
    [ "$same_status" -eq 1 ] || {
      printf '%s\n' 'SERVER POLICY: cannot validate the chained pre-push hook; push stopped safely.' >&2
      exit 1
    }
  fi
  "$chained_hook" "$remote" "$push_url" <"$input_file"
else
  chained_status=$?
  if [ "$chained_status" -ne 1 ]; then
    printf '%s\n' 'SERVER POLICY: cannot resolve the chained pre-push hook; push stopped safely.' >&2
    exit 1
  fi
fi

exit 0
