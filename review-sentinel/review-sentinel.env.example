# Copy to /home/claude/.config/review-sentinel/review-sentinel.env and keep mode 0600.
# Leave the service disabled until a server-owned GitHub App is created.
REVIEW_SENTINEL_APP_ID=
REVIEW_SENTINEL_PRIVATE_KEY_FILE=/home/claude/.config/review-sentinel/app.pem
REVIEW_SENTINEL_WEBHOOK_SECRET=
REVIEW_SENTINEL_ALLOWED_REPOSITORIES=
REVIEW_SENTINEL_APPROVED_PUBLIC_REPOSITORIES=
REVIEW_SENTINEL_AUTO_PUBLISH_PRIVATE=false
REVIEW_SENTINEL_DATA_DIR=/home/claude/.local/state/review-sentinel
REVIEW_SENTINEL_SCHEMA_FILE=/home/claude/.local/share/review-sentinel/schema.json
# The executable and home must be dedicated to this service. Do not point them
# at the interactive ~/.codex or a wrapper containing unrelated credentials.
REVIEW_SENTINEL_CODEX_BIN=
REVIEW_SENTINEL_CODEX_HOME=/home/claude/.local/share/review-sentinel/codex-home
REVIEW_SENTINEL_REVIEW_TIMEOUT_SECONDS=600
REVIEW_SENTINEL_MAX_ARCHIVE_BYTES=268435456
REVIEW_SENTINEL_MAX_EXTRACTED_BYTES=1073741824
REVIEW_SENTINEL_MAX_QUEUE=20
REVIEW_SENTINEL_BIND_HOST=127.0.0.1
REVIEW_SENTINEL_BIND_PORT=8765
REVIEW_SENTINEL_TRIGGER_LABEL=review-sentinel
REVIEW_SENTINEL_PUBLISH_LABEL=review-sentinel-publish
